{
  "name": "@combo-sh/cli",
  "version": "0.1.0",
  "description": "Official CLI & MCP agent tools for Combo (combo.sh) - Storage, Edge CDN, Deepgram TTS and STT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://combo.sh",
  "bin": {
    "combo": "./bin/combo.js",
    "combo-cli": "./bin/combo.js",
    "cli": "./bin/combo.js",
    "milo": "./bin/combo.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=dist/cli.mjs",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=dist/mcp.mjs",
    "prepack": "pnpm run build:cli && pnpm run build:mcp",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "combo": "tsx src/cli/index.ts",
    "milo": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@ibm/plex": "^6.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@smithy/node-http-handler": "^4.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.3.3",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
